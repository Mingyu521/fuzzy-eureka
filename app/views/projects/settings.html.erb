<% content_for :title, "#{@project.name} — Settings" %>

<div class="page-header">
  <div>
    <h1 class="page-title rainbow-text">Settings ⚙️</h1>
    <p class="page-subtitle">Project configuration</p>
  </div>
</div>

<div class="card" style="max-width: 560px; margin-bottom: 20px;">
  <div class="field">
    <label>Project name</label>
    <div style="color: #fff; font-size: 15px; font-weight: 700;"><%= @project.name %></div>
  </div>

  <div class="field">
    <label>Project ID</label>
    <div class="api-key-reveal"><code><%= @project.id %></code></div>
  </div>

  <div class="field" data-controller="reveal" data-reveal-real-value="<%= @project.api_key %>" data-reveal-masked-value="ev_••••••••••••••••••••••••••••••••••••••">
    <label>API key</label>
    <div class="api-key-reveal">
      <code data-reveal-target="value" style="flex-grow: 1; word-break: break-all;"></code>
      <button type="button" class="btn" data-reveal-target="toggle" data-action="reveal#toggle">Reveal</button>
    </div>
  </div>
</div>

<div class="card" style="max-width: 560px; border-color: rgba(255, 16, 240, 0.4);">
  <h2 style="font-family: var(--font-display); font-size: 13px; color: var(--pink); margin-top: 0;">Danger zone</h2>
  <p style="color: var(--ink-dim); font-size: 12.5px;">Deletes this project and every channel, event, and insight in it. This cannot be undone.</p>
  <%= button_to "Delete project", project_path(@project), method: :delete, class: "btn btn--danger",
        data: { turbo_confirm: "Delete \"#{@project.name}\" and all of its events? This cannot be undone." } %>
</div>
